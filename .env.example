# Webina — environment variables (never commit a real value)
#
# The app connects with the LEAST-PRIVILEGE role (webina_app): no DDL, no
# table ownership, NOBYPASSRLS. The migrator connection string is used only by
# `pnpm db:migrate` on a developer machine or in CI — never in a Vercel env.
#
# Neon: use the POOLED host (it contains "-pooler") for DATABASE_URL.

# Runtime (Vercel: app.webina.io)
DATABASE_URL="postgresql://webina_app:PASSWORD@HOST-pooler.ap-southeast-2.aws.neon.tech/webina?sslmode=require"

# Migrations only (local shell / CI). Never set on Vercel.
MIGRATE_DATABASE_URL="postgresql://webina_migrator:PASSWORD@HOST.ap-southeast-2.aws.neon.tech/webina?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="https://app.webina.io"

# Public origin of the dashboard app
APP_BASE_URL="https://app.webina.io"

# AI (Milestone 3). Pinned model id; never hard-code it in source.
ANTHROPIC_API_KEY=""
AGENT_MODEL="claude-sonnet-4-5-20250929"

# Tests (local Postgres or a Neon branch). CI sets these itself.
TEST_ADMIN_DATABASE_URL="postgresql://postgres@127.0.0.1:5433/postgres"
